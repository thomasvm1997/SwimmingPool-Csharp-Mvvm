@model QuotationIndexViewModel

@if (User.IsInRole("Admin"))
{
    <h1>Alle offertes</h1>
}
else 
{
    <h1>Mijn offertes</h1>
}

<div class="row">
    <table class="table table-hover">
        <tr>
            <th>Klant</th>
            <th>Prijs</th>
            <th>Aanvraag datum</th>
            <th>Status</th>
            <th>Zwembaden</th>
            <th>Commentaar klant</th>
            <th>Commentaar Baas</th>
            <th>Respons datum</th>
            <th>Acties</th>
        </tr>
        @foreach (var item in Model.Quotations)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.Price</td>
                <td>@item.RequestDate</td>
                <td>
                    <span class="status-label @item.Status">
                        @item.Status
                    </span>
                </td>
                <td>
                    @foreach (var pool in item.SwimmingpoolNames)
                    {
                        <p>@pool</p>
                    }
                <td>@item.CustomerComment</td>
                <td>@item.AdminComment</td>
                <td>@item.ResponseDate</td>
                <td>
                    <a asp-controller="Quotation"
                       asp-action="UpdateQuotation"
                       asp-route-quotationId="@item.Id"
                       class="btn btn-outline-primary btn-sm">
                        ✏️ Update
                    </a>
                </td>
            </tr>
        }
    </table>
</div>
