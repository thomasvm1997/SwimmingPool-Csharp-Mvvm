@model CreateQuotationWithPoolViewModel

@{
    ViewData["Title"] = "Create Quotation";
}

<h1>Create Quotation</h1>

<form asp-action="CreateQuotation" method="post">
    <div>
        <h3>Swimming Pool Details</h3>

        <div>
            <label asp-for="SwimmingPool.Name"></label>
            <input asp-for="SwimmingPool.Name" class="form-control" />
            <span asp-validation-for="SwimmingPool.Name" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="SwimmingPool.Length"></label>
            <input asp-for="SwimmingPool.Length" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="SwimmingPool.Length" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="SwimmingPool.Width"></label>
            <input asp-for="SwimmingPool.Width" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="SwimmingPool.Width" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="SwimmingPool.Depth"></label>
            <input asp-for="SwimmingPool.Depth" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="SwimmingPool.Depth" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="SwimmingPool.HasHeating"></label>
            <input asp-for="SwimmingPool.HasHeating" class="form-check-input" type="checkbox" />
            <span asp-validation-for="SwimmingPool.HasHeating" class="text-danger"></span>
        </div>
    </div>

    <hr />

    <div>
        <h3>Quotation Details</h3>

        <div>
            <label asp-for="Quotation.CustomerComment"></label>
            <textarea asp-for="Quotation.CustomerComment" class="form-control"></textarea>
            <span asp-validation-for="Quotation.CustomerComment" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Maak Offerte</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        
        const errorMessage = '@ViewBag.ErrorMessage';
        if (errorMessage) {
            alert(errorMessage); 
        }
    });
</script>